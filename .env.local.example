# VendorHub – Local Development Environment Variables
# 1. Copy this file to .env.local  (git-ignored)
# 2. Fill in your Firebase project values
# 3. Run:  node vercel-build.js   to generate assets/js/config/__env.js

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

VITE_GEMINI_API_KEY=your-gemini-api-key-here
