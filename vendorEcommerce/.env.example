# VendorHub – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NOTE: This project uses Firebase JS SDK (client-side), so keys are loaded
# directly in firebase-config.js.  For production, consider a bundler like
# Vite/Webpack and inject these via import.meta.env.

# ── Firebase ──────────────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── ImageKit (product image uploads) ────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Google Gemini AI (optional) ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
